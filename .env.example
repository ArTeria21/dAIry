# Telegram bot
BOT_TOKEN=123456:telegram-bot-token
ALLOWED_USER_ID=123456789

# OpenRouter / transcription
OPENROUTER_API_KEY=sk-or-xxx
VOICE_MODEL_NAME=mistralai/voxtral-small-24b-2507
QUESTION_MODEL_NAME=openai/gpt-4.1-mini
QUESTION_LANGUAGE=ru
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEP_QUESTION_START_HOUR=11
DEEP_QUESTION_END_HOUR=20

# Journaling paths
# Inside container: keep at /data (matches docker-compose bind mount)
JOURNAL_DIR=/data
# Host path to your Obsidian Git repo (absolute path on your machine)
HOST_JOURNAL_DIR=/absolute/path/to/your/obsidian/git/repo

# Timezone and git toggle
TIMEZONE=Europe/Vienna
GIT_ENABLED=true

# Table of Contents indexing (optional)
# Set to true to auto-generate table_of_contents.md in your vault
TOC_ENABLED=false
# TOC_FILENAME=table_of_contents.md
# Extra directories to index (comma-separated, relative to JOURNAL_DIR)
# TOC_EXTRA_INCLUDE_DIRS=EXTRA
# How often to scan for manual edits (minutes)
# TOC_SCAN_INTERVAL_MINUTES=10
# LLM model for summaries (defaults to QUESTION_MODEL_NAME)
# TOC_MODEL_NAME=openai/gpt-4.1-mini
# TOC_MAX_TAGS=5