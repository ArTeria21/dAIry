# Telegram bot
BOT_TOKEN=123456:telegram-bot-token
ALLOWED_USER_ID=123456789

# OpenRouter / transcription
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VOICE_MODEL_NAME=google/gemini-3.5-flash

# Journaling paths
# В контейнере оставляем /data: docker-compose монтирует сюда HOST_JOURNAL_DIR.
JOURNAL_DIR=/data
# Абсолютный путь на хосте к Obsidian/vault Git-репозиторию.
HOST_JOURNAL_DIR=/absolute/path/to/your/obsidian/git/repo
# Приватный ключ для Git remote over SSH. Это должен быть файл, не директория.
SSH_KEY_PATH=/absolute/path/to/private/ssh/key

# Timezone and git toggle
TIMEZONE=Europe/Vienna
LANGUAGE=EN
GIT_ENABLED=true

# Table of Contents indexing
TOC_ENABLED=true
TOC_FILENAME=table_of_contents.md

# Дополнительные папки для индексации, через запятую, относительно JOURNAL_DIR.
# TOC_EXTRA_INCLUDE_DIRS=EXTRA
TOC_SCAN_INTERVAL_MINUTES=10

# Необязательный override модели enrichment.
TOC_MODEL_NAME=google/gemini-3.1-flash-lite
TOC_MAX_TAGS=5

# LLM enrichment
# ENRICHMENT_ENABLED=true включает immediate note-level enrichment для сегодняшних
# заметок и тихий day-level/watchdog слой вместе с TOC.
ENRICHMENT_ENABLED=true
ENRICHMENT_MODEL_NAME=google/gemini-3.1-flash-lite
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
ENRICHMENT_DB_PATH=data/enrichment.sqlite3

# Layer 3 web analytics
# Public access is expected to terminate TLS in the existing reverse proxy,
# then proxy to http://127.0.0.1:${LAYER3_FRONTEND_PORT}.
LAYER3_FRONTEND_BIND=127.0.0.1
LAYER3_FRONTEND_PORT=18080

# Single-user web login. Store only an argon2 hash, never plaintext.
WEB_USERNAME=artem
WEB_PASSWORD_ARGON2='$argon2id$v=19$m=65536,t=3,p=4$replace-with-generated-hash'
WEB_SESSION_SECRET=replace-with-long-random-secret
WEB_COOKIE_SECURE=true
WEB_LOGIN_RATE_LIMIT_ATTEMPTS=5
WEB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
